# ==============================================================================
# AI Business Platform - Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# ==============================================================================

# Application Environment
APP_ENV=development

# API Gateway Entrypoint
GATEWAY_PORT=8080

# ==============================================================================
# POSTGRESQL DATABASE
# ==============================================================================
# Credentials used by PostgreSQL container and Spring Boot microservices
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ai_platform

# ==============================================================================
# SECURITY / JWT
# ==============================================================================
# Shared HMAC-SHA256 secret key across all microservices (Base64-encoded, min 256 bits)
# Example: echo -n "your-secret-key-at-least-32-chars-long" | base64
JWT_SECRET=dGhpc2lzYXZlcnlzZWNyZXRrZXlmb3Jqd3RoZXJlMTIzNDU=
JWT_EXPIRATION=86400000

# Optional initial administrator bootstrap (disabled by default)
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@platform.local
INITIAL_ADMIN_PASSWORD=

# ==============================================================================
# ANALYTICS SERVICE
# ==============================================================================
ANALYTICS_SERVICE_PORT=8085
ANALYTICS_CURRENCY=EUR
ANALYTICS_DEFAULT_TIMEZONE=UTC
ANALYTICS_LOW_STOCK_THRESHOLD=5

# ==============================================================================
# SAGA ORCHESTRATION, DURABLE RECOVERY & STOCK RECONCILIATION
# ==============================================================================
# Automatic background compensation worker for interrupted / failed sagas
SAGA_RECOVERY_ENABLED=true
SAGA_RECOVERY_INTERVAL_MS=5000
SAGA_RECOVERY_BATCH_SIZE=10
SAGA_RECOVERY_MAX_ATTEMPTS=5
SAGA_RECOVERY_INITIAL_BACKOFF_MS=1000
SAGA_RECOVERY_MAX_BACKOFF_MS=30000
SAGA_RECOVERY_BACKOFF_MULTIPLIER=2.0

# Scheduled audit job detecting discrepancies between sales and reservations (read-only)
SAGA_RECONCILIATION_ENABLED=true
SAGA_RECONCILIATION_INTERVAL_MS=60000
SAGA_RECONCILIATION_STALE_MINUTES=15


# ==============================================================================
# OBSERVABILITY STACK (Prometheus, Grafana, Loki, Alloy)
# ==============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
LOKI_PORT=3100

# ==============================================================================
# REDIS CACHE
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# FUTURE SERVICES (Kafka, AI, Vector DB)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3
CHROMA_HOST=chromadb
CHROMA_PORT=8000
